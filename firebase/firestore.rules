rules_version = '2';



service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }


    match /{path=**}/ownershipRequests/{placeId} {
      allow read: if isAdmin();
    }

    function validDecision(uid, placeId) {
      let d = request.resource.data;
      let decision = {'operator': d.operator, 'reason': d.reason, 'decidedAt': d.decidedAt};
      return isAdmin() && request.auth.uid != uid
        && resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/places/$(placeId))
        && d.createdAt == resource.data.createdAt
        && d.operator == request.auth.uid && d.decidedAt == request.time
        && d.reason is string && d.reason == d.reason.trim()
        && d.reason.size() >= 1 && d.reason.size() <= 500
        && ((d.status == 'rejected'
          && d.keys().hasOnly(['status', 'createdAt', 'operator', 'reason', 'decidedAt', 'rejection'])
          && d.rejection == decision)
        || (d.status == 'approved'
          && d.keys().hasOnly(['status', 'createdAt', 'operator', 'reason', 'decidedAt', 'approval'])
          && d.approval == decision
          && !exists(/databases/$(database)/documents/placeOwners/$(placeId))
          && getAfter(/databases/$(database)/documents/placeOwners/$(placeId)).data == {'uid': uid, 'verifiedAt': request.time}));
    }

    function validFoodTags(tags) {
      return tags is list && tags.size() <= 8
        && tags.toSet().size() == tags.size()
        && tags.hasOnly(['caseiro', 'vegetariano', 'vegano', 'low-carb', 'integral',
                         'marmita', 'quentinha', 'self-service']);
    }

    function notBusinessOwner(placeId) {
      let path = /databases/$(database)/documents/placeOwners/$(placeId);
      return !exists(path) || get(path).data.uid != request.auth.uid;
    }

    match /placeOwners/{placeId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'verifiedAt'])
        && request.resource.data.uid is string
        && request.resource.data.uid != request.auth.uid
        && request.resource.data.verifiedAt == request.time
        && exists(/databases/$(database)/documents/places/$(placeId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)/ownershipRequests/$(placeId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)/ownershipRequests/$(placeId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)/ownershipRequests/$(placeId)).data.operator == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)/ownershipRequests/$(placeId)).data.decidedAt == request.time;
      allow update, delete: if false;
    }


    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'displayNameLower', 'username', 'bio', 'city', 'instagram'])
        && data.keys().hasAll(['displayName', 'displayNameLower'])
        && data.displayName is string
        && data.displayName.trim().size() > 0
        && data.displayName == data.displayName.trim()
        && data.displayName.size() <= 60
        && data.displayNameLower == data.displayName.lower()
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 240))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('instagram' in data) || (data.instagram is string && (data.instagram == '' || data.instagram.matches('[a-zA-Z0-9._]{1,30}'))))
        && (!('username' in data) || (data.username is string
          && data.username.matches('[a-z0-9][a-z0-9._]{2,23}')
          && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile(request.resource.data);


      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && (!('username' in resource.data)
          || ('username' in request.resource.data &&
            (request.resource.data.username == resource.data.username
            || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)))));
      allow delete: if false;

      match /media/{kind} {
        allow read: if signedIn() && kind in ['avatar', 'cover'];
        allow create, update: if isOwner(uid) && kind in ['avatar', 'cover']
          && request.resource.data.keys().hasOnly(['jpeg'])
          && request.resource.data.keys().hasAll(['jpeg'])
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() > 0 && request.resource.data.jpeg.size() <= 150000;
        allow delete: if isOwner(uid) && kind in ['avatar', 'cover'];
      }

      match /ownershipRequests/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/places/$(placeId))
          && request.resource.data.keys().hasOnly(['status', 'createdAt'])
          && request.resource.data.keys().hasAll(['status', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if validDecision(uid, placeId);
        allow delete: if false;
      }

      match /preferences/{preferenceId} {
        allow read: if isOwner(uid) && preferenceId in ['food', 'privacy'];
        allow create, update: if isOwner(uid) && preferenceId == 'food'
          && request.resource.data.keys().hasOnly(['tags'])
          && request.resource.data.keys().hasAll(['tags'])
          && validFoodTags(request.resource.data.tags);
        allow delete: if false;
      }

      match /preferences/privacy {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['silent'])
          && request.resource.data.keys().hasAll(['silent'])
          && request.resource.data.silent is bool;
        allow delete: if false;
      }

      match /following/{targetUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && targetUid != uid
          && exists(/databases/$(database)/documents/users/$(targetUid))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }












      match /reviewLocks/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validLock(placeId, request.resource.data);
        allow update: if isOwner(uid)
          && validLock(placeId, request.resource.data)
          && request.time >= resource.data.lastAt + duration.value(30, 'd');
        allow delete: if false;
      }








      match /visitLocks/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validVisitLock(placeId, request.resource.data);
        allow update: if isOwner(uid)
          && validVisitLock(placeId, request.resource.data)
          && request.time >= resource.data.lastAt + duration.value(12, 'h');
        allow delete: if false;
      }







      match /openReportLocks/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validOpenReportLock(placeId, request.resource.data);
        allow update: if isOwner(uid)
          && validOpenReportLock(placeId, request.resource.data)
          && request.time >= resource.data.lastAt + duration.value(30, 'm');
        allow delete: if false;
      }

      match /queueReportLocks/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validQueueReportLock(placeId, request.resource.data);
        allow update: if isOwner(uid)
          && validQueueReportLock(placeId, request.resource.data)
          && request.time >= resource.data.lastAt + duration.value(30, 'm');
        allow delete: if false;
      }

      match /saved/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/places/$(placeId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }







      match /lists/{listId} {
        allow read: if isOwner(uid)
          || (signedIn()
              && resource.data.visible == true
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(uid)));
        allow create: if isOwner(uid)
          && validList(request.resource.data)
          && validCopiedFrom(uid, request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && validList(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(copiedFromKeys());
        allow delete: if isOwner(uid);





        match /copies/{copierUid} {
          allow read: if isOwner(uid) || isOwner(copierUid);
          allow create: if isOwner(copierUid)
            && request.resource.data.keys().hasOnly(['createdAt', 'copiedListId'])
            && request.resource.data.keys().hasAll(['createdAt', 'copiedListId'])
            && validCopyReceipt(uid, listId, copierUid, request.resource.data)
            && request.resource.data.createdAt == request.time;
          allow delete: if isOwner(uid);
          allow update: if isOwner(copierUid)
            && resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.keys().hasOnly(['createdAt', 'copiedListId'])
            && request.resource.data.keys().hasAll(['createdAt', 'copiedListId'])
            && request.resource.data.createdAt == resource.data.createdAt
            && validCopyReceipt(uid, listId, copierUid, request.resource.data);
        }
      }
    }

    match /usernames/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && handle.matches('[a-z0-9][a-z0-9._]{2,23}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == handle;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != handle;
    }

    function validCopyReceipt(ownerUid, listId, copierUid, data) {
      return ownerUid != copierUid
        && data.copiedListId is string && data.copiedListId.matches('[^/]{1,128}')
        && exists(/databases/$(database)/documents/users/$(copierUid)/following/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)/lists/$(listId)).data.visible == true
        && getAfter(/databases/$(database)/documents/users/$(copierUid)/lists/$(data.copiedListId)).data.copiedFromUid == ownerUid
        && getAfter(/databases/$(database)/documents/users/$(copierUid)/lists/$(data.copiedListId)).data.copiedFromListId == listId
        && getAfter(/databases/$(database)/documents/users/$(copierUid)/lists/$(data.copiedListId)).data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/users/$(copierUid)/lists/$(data.copiedListId)).data.createdAt <= request.time;
    }

    function lockKeys() {
      return ['lastAt', 'reviewId', 'placeId'];
    }


    function validLock(placeId, data) {
      let reviewPath = /databases/$(database)/documents/reviews/$(data.reviewId);
      let review = getAfter(reviewPath);
      return data.keys().hasOnly(lockKeys())
        && data.keys().hasAll(lockKeys())
        && data.placeId == placeId
        && data.reviewId is string
        && data.lastAt == request.time
        && !exists(reviewPath)
        && review != null
        && review.data.authorId == request.auth.uid
        && review.data.placeId == placeId;
    }

    function visitLockKeys() {
      return ['lastAt', 'visitId', 'placeId'];
    }


    function validVisitLock(placeId, data) {
      let visitPath = /databases/$(database)/documents/visits/$(data.visitId);
      let visit = getAfter(visitPath);
      return data.keys().hasOnly(visitLockKeys())
        && data.keys().hasAll(visitLockKeys())
        && data.placeId == placeId
        && data.visitId is string
        && data.lastAt == request.time
        && !exists(visitPath)
        && visit != null
        && visit.data.authorId == request.auth.uid
        && visit.data.placeId == placeId;
    }

    function openReportLockKeys() {
      return ['lastAt', 'reportId', 'placeId'];
    }


    function validOpenReportLock(placeId, data) {
      let reportPath = /databases/$(database)/documents/openReports/$(data.reportId);
      let report = getAfter(reportPath);
      return data.keys().hasOnly(openReportLockKeys())
        && data.keys().hasAll(openReportLockKeys())
        && data.placeId == placeId
        && data.reportId is string
        && data.lastAt == request.time
        && !exists(reportPath)
        && report != null
        && report.data.authorId == request.auth.uid
        && report.data.placeId == placeId;
    }

    function queueReportLockKeys() {
      return ['lastAt', 'reportId', 'placeId'];
    }


    function validQueueReportLock(placeId, data) {
      let reportPath = /databases/$(database)/documents/queueReports/$(data.reportId);
      let report = getAfter(reportPath);
      return data.keys().hasOnly(queueReportLockKeys())
        && data.keys().hasAll(queueReportLockKeys())
        && data.placeId == placeId
        && data.reportId is string
        && data.lastAt == request.time
        && !exists(reportPath)
        && report != null
        && report.data.authorId == request.auth.uid
        && report.data.placeId == placeId;
    }



    function listKeys() {
      return ['name', 'emoji', 'placeIds', 'createdAt', 'updatedAt'];
    }


    function copiedFromKeys() {
      return ['copiedFromUid', 'copiedFromName', 'copiedFromListId'];
    }

    function listAllowedKeys() {
      return listKeys().concat(['visible']).concat(copiedFromKeys());
    }





    function validCopiedFrom(uid, data) {
      return !data.keys().hasAny(copiedFromKeys())
        || (data.keys().hasAll(copiedFromKeys())
            && data.copiedFromUid is string
            && data.copiedFromListId is string
            && data.copiedFromName is string
            && data.copiedFromUid != uid
            && exists(/databases/$(database)/documents/users/$(uid)/following/$(data.copiedFromUid))
            && get(/databases/$(database)/documents/users/$(data.copiedFromUid)/lists/$(data.copiedFromListId)).data.visible == true
            && data.copiedFromName == get(/databases/$(database)/documents/users/$(data.copiedFromUid)).data.displayName);
    }


    function listEmojis() {
      return ['🎉', '🍕', '🍔', '🍣', '🍻', '☕', '🍰', '🌮', '🌊', '💑', '👯', '⭐'];
    }

    function validList(data) {
      return data.keys().hasOnly(listAllowedKeys())
        && data.keys().hasAll(listKeys())
        && (!('visible' in data) || data.visible is bool)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.name == data.name.trim()

        && !data.name.matches('.*\\s\\s.*')
        && (data.emoji == null || data.emoji in listEmojis())
        && data.placeIds is list
        && data.placeIds.size() <= 200;
    }











    function placeKeys() {
      return ['name', 'category', 'neighborhood', 'city', 'address', 'lat',
              'lng', 'geohash', 'osmId', 'source', 'createdBy', 'createdAt'];
    }




    function placeCategories() {
      return ['Restaurante', 'Lanchonete', 'Pub', 'Bar', 'Café', 'Sorveteria',
              'Praça de alimentação', 'Cervejaria', 'Pizzaria', 'Hamburgueria',
              'Japonês', 'Churrascaria', 'Frutos do mar', 'Padaria',
              'Tapiocaria', 'Açaí', 'Comida regional', 'Comida brasileira',
              'Italiano', 'Chinês', 'Árabe', 'Mexicano', 'Vegetariano', 'Vegano',
              'Mercado', 'Feira'];
    }

    function osmTypeName(letter) {
      return {'n': 'node', 'w': 'way', 'r': 'relation'}.get(letter, '');
    }

    function optionalText(v) {
      return v is string && v.size() <= 120;
    }




    function inBrazilBounds(lat, lng) {
      return lat is number && lng is number
        && lat >= -34.0 && lat <= 5.5
        && lng >= -74.0 && lng <= -28.5;
    }

    function validNewPlace(data, placeId) {
      return placeId.matches('osm-[nwr][1-9][0-9]*')
        && data.keys().hasOnly(placeKeys())
        && data.keys().hasAll(placeKeys())
        && data.name is string
        && data.name == data.name.trim()
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.category in placeCategories()
        && optionalText(data.neighborhood)
        && optionalText(data.city)
        && optionalText(data.address)
        && inBrazilBounds(data.lat, data.lng)



        && data.geohash is string
        && data.geohash.matches('[0-9b-hjkmnp-z]{9}')
        && data.osmId == osmTypeName(placeId[4]) + '/' + placeId[5:placeId.size()]
        && data.source == 'osm'
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && validNewPlace(request.resource.data, placeId);
      allow update, delete: if false;
      match /photos/{photoId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/places/$(placeId))
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'createdAt', 'jpeg'])
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'createdAt', 'jpeg'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.createdAt == request.time
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() > 0
          && request.resource.data.jpeg.size() <= 150000;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }


    function validScore(v) {
      return v is int && v >= 1 && v <= 5;
    }




    function validAxis(v) {
      return v == null || validScore(v);
    }

    function validAxes(data) {
      return validAxis(data.food)
        && validAxis(data.ambience)
        && validAxis(data['service'])
        && (data.food != null || data.ambience != null || data['service'] != null);
    }

    function validCompanion(v) {
      return v == null || v in ['sozinho', 'casal', 'amigos', 'familia', 'trabalho'];
    }



    function validComment(v) {
      return v == null || (v is string && v.size() >= 1 && v.size() <= 280);
    }


    function reviewRequiredKeys() {
      return ['authorId', 'authorName', 'placeId', 'placeName',
              'food', 'ambience', 'service', 'companion', 'comment', 'createdAt'];
    }




    function reviewKeys() {
      return reviewRequiredKeys().concat(['hasPhoto', 'priceBand', 'tags', 'silent', 'couvert', 'serviceFee']);
    }





    // F28: couvert e taxa de 10%, opcionais (ausente, null ou bool).
    function validBillExtras(data) {
      return (!('couvert' in data) || data.couvert == null || data.couvert is bool)
        && (!('serviceFee' in data) || data.serviceFee == null || data.serviceFee is bool);
    }

    function validPriceBand(data) {
      return !('priceBand' in data)
        || data.priceBand == null
        || (data.priceBand is int && data.priceBand >= 1 && data.priceBand <= 5);
    }

    function photoPath(reviewId) {
      return /databases/$(database)/documents/reviewPhotos/$(reviewId);
    }





    function validHasPhoto(data, reviewId) {
      return !('hasPhoto' in data)
        || (data.hasPhoto is bool
            && (data.hasPhoto == false || existsAfter(photoPath(reviewId))));
    }

    function lockPath(uid, placeId) {
      return /databases/$(database)/documents/users/$(uid)/reviewLocks/$(placeId);
    }

    function validReview(data, reviewId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let placePath = /databases/$(database)/documents/places/$(data.placeId);

      let lock = getAfter(lockPath(request.auth.uid, data.placeId));
      return data.keys().hasOnly(reviewKeys())
        && data.keys().hasAll(reviewRequiredKeys())
        && data.authorId == request.auth.uid
        && notBusinessOwner(data.placeId)
        && data.authorName == profile.data.displayName
        && data.placeId is string

        && existsAfter(placePath)
        && data.placeName == getAfter(placePath).data.name
        && (!('tags' in data) || validFoodTags(data.tags))
        && validAxes(data)
        && validCompanion(data.companion)
        && validComment(data.comment)
        && validHasPhoto(data, reviewId)
        && (!('silent' in data) || data.silent is bool)
        && validPriceBand(data)
        && validBillExtras(data)



        && lock != null
        && lock.data.lastAt == request.time
        && lock.data.reviewId == reviewId

        && existsAfter(auditPath('reviews', reviewId))
        && data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && validReview(request.resource.data, reviewId);

      allow update, delete: if false;
    }






    function visitKeys() {
      return ['authorId', 'authorName', 'placeId', 'placeName', 'companion', 'createdAt'];
    }



    function visitAllowedKeys() {
      return visitKeys().concat(['priceBand', 'silent', 'couvert', 'serviceFee']);
    }

    function visitLockPath(uid, placeId) {
      return /databases/$(database)/documents/users/$(uid)/visitLocks/$(placeId);
    }

    function validVisit(data, visitId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let placePath = /databases/$(database)/documents/places/$(data.placeId);
      let lock = getAfter(visitLockPath(request.auth.uid, data.placeId));
      return data.keys().hasOnly(visitAllowedKeys())
        && data.keys().hasAll(visitKeys())
        && data.authorId == request.auth.uid
        && notBusinessOwner(data.placeId)
        && data.authorName == profile.data.displayName
        && data.placeId is string

        && existsAfter(placePath)
        && data.placeName == getAfter(placePath).data.name
        && validCompanion(data.companion)
        && (!('silent' in data) || data.silent is bool)
        && validPriceBand(data)
        && validBillExtras(data)
        && lock != null
        && lock.data.lastAt == request.time
        && lock.data.visitId == visitId

        && existsAfter(auditPath('visits', visitId))
        && data.createdAt == request.time;
    }

    match /visits/{visitId} {
      allow read: if signedIn();
      allow create: if signedIn() && validVisit(request.resource.data, visitId);
      allow update, delete: if false;
    }








    function openReportKeys() {
      return ['authorId', 'authorName', 'placeId', 'open', 'createdAt'];
    }

    function openReportLockPath(uid, placeId) {
      return /databases/$(database)/documents/users/$(uid)/openReportLocks/$(placeId);
    }

    function validOpenReport(data, reportId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let lock = getAfter(openReportLockPath(request.auth.uid, data.placeId));
      return data.keys().hasOnly(openReportKeys())
        && data.keys().hasAll(openReportKeys())
        && data.authorId == request.auth.uid
        && notBusinessOwner(data.placeId)
        && data.authorName == profile.data.displayName
        && data.placeId is string

        && existsAfter(/databases/$(database)/documents/places/$(data.placeId))
        && data.open is bool
        && lock != null
        && lock.data.lastAt == request.time
        && lock.data.reportId == reportId

        && existsAfter(auditPath('openReports', reportId))
        && data.createdAt == request.time;
    }

    match /openReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && validOpenReport(request.resource.data, reportId);
      allow update, delete: if false;
    }

    function queueReportKeys() {
      return ['authorId', 'authorName', 'placeId', 'minutes', 'createdAt'];
    }

    function queueReportLockPath(uid, placeId) {
      return /databases/$(database)/documents/users/$(uid)/queueReportLocks/$(placeId);
    }

    function validQueueReport(data, reportId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let lock = getAfter(queueReportLockPath(request.auth.uid, data.placeId));
      return data.keys().hasOnly(queueReportKeys())
        && data.keys().hasAll(queueReportKeys())
        && data.authorId == request.auth.uid
        && notBusinessOwner(data.placeId)
        && data.authorName == profile.data.displayName
        && data.placeId is string

        && existsAfter(/databases/$(database)/documents/places/$(data.placeId))
        && data.minutes is int && data.minutes >= 0 && data.minutes <= 180
        && lock != null
        && lock.data.lastAt == request.time
        && lock.data.reportId == reportId

        && existsAfter(auditPath('queueReports', reportId))
        && data.createdAt == request.time;
    }

    match /queueReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && validQueueReport(request.resource.data, reportId);
      allow update, delete: if false;
    }


    match /placePresentations/{placeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/places/$(placeId))
        && get(/databases/$(database)/documents/placeOwners/$(placeId)).data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['description', 'hours', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['description', 'hours', 'updatedBy', 'updatedAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.hours is string
        && request.resource.data.hours.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /ownerReplies/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'placeId', 'reviewId', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'placeId', 'reviewId', 'text', 'createdAt'])
        && request.resource.data.reviewId == reviewId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.placeId == get(/databases/$(database)/documents/reviews/$(reviewId)).data.placeId
        && get(/databases/$(database)/documents/placeOwners/$(request.resource.data.placeId)).data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text == request.resource.data.text.trim()
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && existsAfter(auditPath('ownerReplies', reviewId));
      allow update, delete: if false;
    }


    match /config/features {
      allow read: if signedIn();
      allow write: if false;
    }
    match /sponsoredSlots/{slotId} {
      allow read: if signedIn()
        && get(/databases/$(database)/documents/config/features).data.sponsorshipEnabled == true
        && resource.data.keys().hasOnly(['placeId', 'startsAt', 'endsAt'])
        && resource.data.startsAt <= request.time && resource.data.endsAt > request.time
        && exists(/databases/$(database)/documents/placeOwners/$(resource.data.placeId))
        && exists(/databases/$(database)/documents/places/$(resource.data.placeId));
      allow write: if false;
    }








    function auditKeys() {
      return ['actorUid', 'action', 'collection', 'docId', 'placeId', 'at'];
    }

    function auditPath(collectionName, docId) {
      return /databases/$(database)/documents/auditLog/$(collectionName + '-' + docId);
    }

    function validAudit(auditId, data) {
      let targetPath = /databases/$(database)/documents/$(data.collection)/$(data.docId);
      let target = getAfter(targetPath);
      return data.keys().hasOnly(auditKeys())
        && data.keys().hasAll(auditKeys())
        && data.collection in ['reviews', 'visits', 'openReports', 'queueReports', 'ownerReplies']
        && data.docId is string
        && auditId == data.collection + '-' + data.docId
        && data.action == 'create'
        && data.actorUid == request.auth.uid
        && data.placeId is string
        && data.at == request.time

        && !exists(targetPath)
        && target != null
        && target.data.authorId == request.auth.uid
        && target.data.placeId == data.placeId;
    }

    match /auditLog/{auditId} {
      allow create: if signedIn() && validAudit(auditId, request.resource.data);
      allow read, update, delete: if false;
    }






    function photoKeys() {
      return ['authorId', 'jpeg', 'createdAt'];
    }

    match /reviewPhotos/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(photoKeys())
        && request.resource.data.keys().hasAll(photoKeys())
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.jpeg is bytes
        && request.resource.data.jpeg.size() >= 1
        && request.resource.data.jpeg.size() <= 150000


        && request.resource.data.jpeg.toHexString().lower()[0:6] == 'ffd8ff'
        && request.resource.data.createdAt == request.time

        && !exists(/databases/$(database)/documents/reviews/$(reviewId))
        && getAfter(/databases/$(database)/documents/reviews/$(reviewId)).data.authorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/reviews/$(reviewId)).data.get('hasPhoto', false) == true;
      allow update, delete: if false;
    }
  }
}
