rules_version = '2';

// NaÁrea — integridade garantida no servidor (Integridade = prioridade 7).
// Toda regra aqui tem teste em firebase/tests/.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- users ----------
    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'displayNameLower'])
        && data.keys().hasAll(['displayName', 'displayNameLower'])
        && data.displayName is string
        && data.displayName.trim().size() > 0
        && data.displayName == data.displayName.trim()
        && data.displayName.size() <= 60
        && data.displayNameLower == data.displayName.lower();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      // Nome é imutável: reviews.authorName é desnormalizado e ficaria desatualizado.
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'displayNameLower']);
      allow delete: if false;

      match /following/{targetUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && targetUid != uid
          && exists(/databases/$(database)/documents/users/$(targetUid))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // "Quero ir" (F11): privado — só o dono lê e escreve. Doc só com o
      // createdAt do servidor; sem notas nem listas (F12). Salvar de novo um
      // local já salvo seria update: negado (o cliente só cria ou apaga).
      match /saved/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/places/$(placeId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // Listas nomeadas (F12): privadas, subconjunto do "Quero ir" (o app
      // mantém a coerência; remover do Quero ir tira das listas num batch).
      // Nome único sem caixa/acento e o máximo de 30 listas são do app.
      match /lists/{listId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validList(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validList(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    function listKeys() {
      return ['name', 'emoji', 'placeIds', 'createdAt', 'updatedAt'];
    }

    // MESMA lista de `listEmojis` em app/lib/domain/models/place_list.dart.
    function listEmojis() {
      return ['🎉', '🍕', '🍔', '🍣', '🍻', '☕', '🍰', '🌮', '🌊', '💑', '👯', '⭐'];
    }

    function validList(data) {
      return data.keys().hasOnly(listKeys())
        && data.keys().hasAll(listKeys())
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.name == data.name.trim()
        // O app colapsa espaços internos repetidos.
        && !data.name.matches('.*\\s\\s.*')
        && (data.emoji == null || data.emoji in listEmojis())
        && data.placeIds is list
        && data.placeIds.size() <= 200;
    }

    // ---------- places (somente seed/admin escreve) ----------
    match /places/{placeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- reviews ----------
    function validScore(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function validCompanion(v) {
      return v == null || v in ['sozinho', 'casal', 'amigos', 'familia', 'trabalho'];
    }

    // Comentário opcional do autor: chave sempre presente, null quando não há.
    // Vazio é negado (o cliente grava null); imutável como a avaliação.
    function validComment(v) {
      return v == null || (v is string && v.size() >= 1 && v.size() <= 280);
    }

    function reviewKeys() {
      return ['authorId', 'authorName', 'placeId', 'placeName',
              'food', 'ambience', 'service', 'companion', 'comment', 'createdAt'];
    }

    function validReview(data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let placePath = /databases/$(database)/documents/places/$(data.placeId);
      return data.keys().hasOnly(reviewKeys())
        && data.keys().hasAll(reviewKeys())
        && data.authorId == request.auth.uid
        && data.authorName == profile.data.displayName
        && data.placeId is string
        && exists(placePath)
        && data.placeName == get(placePath).data.name
        && validScore(data.food)
        && validScore(data.ambience)
        && validScore(data['service']) // 'service' é palavra reservada nas Rules
        && validCompanion(data.companion)
        && validComment(data.comment)
        && data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && validReview(request.resource.data);
      // Editar/excluir fica para F03/F04.
      allow update, delete: if false;
    }
  }
}
