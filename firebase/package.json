{
  "name": "naarea-firebase",
  "private": true,
  "description": "Testes das Security Rules, import do OpenStreetMap e seed do Firestore do NaÁrea",
  "scripts": {
    "test": "mocha --exit --timeout 20000 \"tests/**/*.test.js\"",
    "test:osm": "mocha tests/osm.test.js",
